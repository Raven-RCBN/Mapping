diff --git a/apps/api/test/session-auth.test.js b/apps/api/test/session-auth.test.js
index 6b944df..67cc71e 100644
--- a/apps/api/test/session-auth.test.js
+++ b/apps/api/test/session-auth.test.js
@@ -62,3 +62,37 @@ test('repeated failed sign-in attempts are throttled', async () => {
   for (let i = 0; i < 12; i++) last = await login('wrong');
   assert.equal(last.status, 429);
 });
+
+test('remembered sessions roll for 30 idle days without reviving expired, revoked or disabled access', async () => {
+  await User.create({ _id: 'RememberTest', passwordHash: await passwordHash('remember-test-password'), role: 'viewer', estateIds: ['estate-a'] });
+  const auth = await sessionAuth(mongoose.connection, origin);
+  const mobile = express();
+  mobile.use('/identity', auth.router);
+  mobile.get('/private', auth.authenticate, (req, res) => res.json(req.access));
+  const signIn = remember => request(mobile).post('/identity/login').set('Origin', origin).set('X-Mapping-Client', '1')
+    .send({ login: 'RememberTest', password: 'remember-test-password', ...(remember === undefined ? {} : { remember }) });
+  const regular = await signIn();
+  assert.equal(regular.status, 200);
+  assert.ok(regular.headers['set-cookie'][0].includes('Max-Age=28800'));
+  assert.equal((await Session.findOne({ subject: 'RememberTest' }).lean()).remember, false);
+  await Session.deleteMany({ subject: 'RememberTest' });
+  assert.equal((await signIn('true')).status, 401);
+  const remembered = await signIn(true);
+  assert.equal(remembered.status, 200);
+  assert.ok(remembered.headers['set-cookie'][0].includes('Max-Age=2592000'));
+  const cookie = remembered.headers['set-cookie'][0].split(';')[0];
+  let record = await Session.findOne({ subject: 'RememberTest' }).lean();
+  assert.equal(record.remember, true);
+  assert.ok(record.expiresAt.getTime() > Date.now() + 29 * 86400000);
+  await Session.updateOne({ _id: record._id }, { expiresAt: new Date(Date.now() + 60000) });
+  assert.equal((await request(mobile).get('/private').set('Cookie', cookie)).status, 200);
+  record = await Session.findById(record._id).lean();
+  assert.ok(record.expiresAt.getTime() > Date.now() + 29 * 86400000);
+  await User.updateOne({ _id: 'RememberTest' }, { active: false });
+  assert.equal((await request(mobile).get('/private').set('Cookie', cookie)).status, 401);
+  await User.updateOne({ _id: 'RememberTest' }, { active: true });
+  await Session.updateOne({ _id: record._id }, { expiresAt: new Date(0) });
+  assert.equal((await request(mobile).get('/private').set('Cookie', cookie)).status, 401);
+  await Session.deleteOne({ _id: record._id });
+  assert.equal((await request(mobile).get('/private').set('Cookie', cookie)).status, 401);
+});
