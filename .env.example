NODE_ENV=development
PORT=4180
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27018/DigitalPalmMapping
DATA_DIR=./data
AUTH_MODE=development
# Required in production: AUTH_MODE=jwt and RS256 public key, issuer, audience.
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
QGIS_SERVER_URL=http://127.0.0.1:4191/ows/
QGIS_PROJECT_ROOT=/data/estates

# Optional build configuration for the hosted AgriNexus subpath:
# VITE_BASE_PATH=/EstateAtlas/
# VITE_API_BASE=/api/EstateAtlas
# VITE_AGRINEXUS_SESSION=true
